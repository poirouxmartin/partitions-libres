<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 7.0 ships without the Let's Encrypt roots (ISRG Root X1 arrived in 7.1.1), so HTTPS to
  Mutopia, raw.githubusercontent.com and GitHub release downloads fails there. Legacy flavor only:
  trust the system store plus the ISRG roots bundled in res/raw (from letsencrypt.org/certificates).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x1" />
            <certificates src="@raw/isrg_root_x2" />
            <certificates src="@raw/isrg_root_yr" />
            <certificates src="@raw/isrg_root_ye" />
        </trust-anchors>
    </base-config>
</network-security-config>
